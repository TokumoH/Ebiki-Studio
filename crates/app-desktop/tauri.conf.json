{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebiki Studio",
  "version": "0.2.0",
  "identifier": "com.ebikistudio.studio",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ebiki Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#14121d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Estúdio musical pessoal",
    "longDescription": "Gravação, mixagem, edição, harmonia, notação e afinação.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TokumoH",
    "copyright": "© 2026 TokumoH — código sob GPL-3.0-or-later; nome e logo reservados",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/TokumoH/Ebiki-Studio",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US"
        ],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 185
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 185
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDREM5NTc5NDQ5OTI0RDcKUldUWEpKbEVlWlhjM000OFZ4Z01aRmttbkF2di9Jbk9qWUtTTnRIUERnMjRyZnZuUEs5cGR3L3cK",
      "endpoints": [
        "https://github.com/TokumoH/Ebiki-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
